# Copiá este archivo como .env.local para programar contra el backend de TU compu (npm run dev:local).
# Vite lo lee solo. .env.local no se sube a git.
VITE_API_URL=http://localhost:3000
VITE_WS_URL=http://localhost:3000
# Login con Google (opcional): mismo Client ID que GOOGLE_CLIENT_ID del backend
VITE_GOOGLE_CLIENT_ID=
# Espacio para publicidad (apagado)
VITE_ADS_ENABLED=false
