# Copiá este archivo como .env.local para desarrollo (los .local no se suben a git)

# URL del backend
VITE_API_URL=http://localhost:3000
VITE_WS_URL=ws://localhost:3000

# Login con Google (opcional). Si queda vacío, el botón de Google no se muestra.
# Es el mismo Client ID que GOOGLE_CLIENT_ID del backend.
VITE_GOOGLE_CLIENT_ID=

# Captcha invisible del registro (Cloudflare Turnstile, opcional): la "Site Key" del widget (es pública).
# Si queda vacío, el registro funciona sin captcha. El backend necesita la "Secret Key" en TURNSTILE_SECRET_KEY.
VITE_TURNSTILE_SITE_KEY=

# Espacio de publicidad entre partidas (apagado). Ver docs/PUBLICIDAD.md antes de activarlo.
VITE_ADS_ENABLED=false
